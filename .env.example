# Environment Configuration Template
COMPOSE_PROJECT_NAME=knowledge-drift
ENVIRONMENT=development

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_drift
POSTGRES_USER=drift_user
POSTGRES_PASSWORD=secure_password_change_me

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me

# Vector Database Configuration
VECTOR_DB_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=all-minilm-l6-v2
OPENAI_API_KEY=your_openai_api_key_here

# Backend Configuration
BACKEND_PORT=3000
BACKEND_HOST=localhost
JWT_SECRET=your_jwt_secret_here_change_me
JWT_EXPIRES_IN=24h

# Frontend Configuration
FRONTEND_PORT=3001
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000

# AI Engine Configuration
AI_ENGINE_PORT=8000
AI_ENGINE_HOST=localhost

# External Services
SLACK_WEBHOOK_URL=your_slack_webhook_here
JIRA_API_URL=your_jira_api_url_here
JIRA_USERNAME=your_jira_username
JIRA_API_TOKEN=your_jira_api_token

# Monitoring and Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_PORT=9090

# Security
CORS_ORIGIN=http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,md,txt,json
