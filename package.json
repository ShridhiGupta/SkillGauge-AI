{
  "name": "skillgauge-ai",
  "version": "1.0.0",
  "description": "SkillGauge AI - AI Knowledge Drift Detector for Engineering Teams",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ai-engine\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "dev:ai-engine": "cd ai-engine && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "npm run test:backend && npm run test:frontend && npm run test:ai-engine",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:ai-engine": "cd ai-engine && pytest",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up --build",
    "setup": "npm run setup:backend && npm run setup:frontend && npm run setup:ai-engine",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install",
    "setup:ai-engine": "cd ai-engine && pip install -r requirements.txt"
  },
  "keywords": [
    "ai",
    "knowledge-management",
    "documentation",
    "drift-detection",
    "engineering",
    "machine-learning"
  ],
  "author": "Knowledge Drift Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "frontend",
    "ai-engine"
  ]
}
